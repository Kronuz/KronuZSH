# kronuzsh: a lean, prezto-free zsh setup.
# Interactive entry point. Symlinked from ~/.zshrc -> runcoms/zshrc.
#
# Author: Germán Méndez Bravo (Kronuz) <german.mb@gmail.com>

# Resolve the repo root. This file lives in runcoms/, so climb out twice (:h:h),
# resolving symlinks first (:A) since ~/.zshrc is a symlink to here.
KRONUZSH="${KRONUZSH:-${${(%):-%x}:A:h:h}}"
export KRONUZSH

source "$KRONUZSH/runcoms/zshenv"   # also sourced by ~/.zshenv; harmless to repeat
source "$KRONUZSH/lib/options.zsh"
source "$KRONUZSH/lib/history.zsh"
source "$KRONUZSH/lib/colors.zsh"   # canonical $LS_COLORS — before completion (it reads it)
source "$KRONUZSH/lib/completion.zsh"
source "$KRONUZSH/lib/keybindings.zsh"
source "$KRONUZSH/lib/aliases.zsh"
source "$KRONUZSH/lib/functions.zsh"
source "$KRONUZSH/lib/python.zsh"
source "$KRONUZSH/lib/terminal.zsh"
source "$KRONUZSH/lib/plugins.zsh"
source "$KRONUZSH/integrations/init.zsh"   # optional external tools (fzf, zoxide, ...), each guarded
source "$KRONUZSH/lib/prompt.zsh"

kz_prompt_setup

# Machine-local, non-public config (tool hooks, corp URLs, KZ_PROMPT_* overrides).
# Tracked example: zshrc.local.example. The real ~/.zshrc.local is yours, in $HOME.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Register after local config so KZ_AUTO_VENV can disable the native hook. The initial
# scan handles shells opened directly inside a project.
_kz_python_venv_setup

# Startup-file bookkeeping must not become the first prompt's command status.
return 0
