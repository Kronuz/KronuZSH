# ~/.zprofile — sourced for LOGIN zsh only, after ~/.zshenv and before ~/.zshrc.
# Symlinked ~/.zprofile -> runcoms/zprofile. Runs once per login; exports set now are
# inherited by every later non-login shell and script. Put login-time, non-interactive
# setup here. Cross-shell machine env (PATH/exports) lives in ~/.profile — read natively
# by sh/bash at login, and sourced below so zsh login shells match.
[[ -r "$HOME/.profile" ]] && source "$HOME/.profile"
