# minimal — a single, spare line: path, git, then a lone caret. No status line,
# no right prompt, no second row. Proof a skin can collapse to one line.
KZ_PROMPT_PROMPT='$kz[pwd]$kz[git] ${kz[FG.magenta]}${kz[GLYPH.caret]}${kz[RESET]} '
KZ_PROMPT_RPROMPT=''
KZ_PROMPT_TRANSIENT_PROMPT='$kz[pwd] ${kz[FG.magenta]}${kz[GLYPH.caret]}${kz[RESET]} '
